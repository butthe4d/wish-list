# Local development settings. `make dev-env` copies this to dev.env (git-ignored)
# with a real SECRET_KEY and this machine's IP; `make run` loads dev.env.
# Keep SECRET_KEY stable: changing it logs everyone out and breaks share links.
export BASE_URL=http://localhost:8000
export SECRET_KEY=replace-me-with-make-dev-env
export ADMIN_EMAIL=you@example.com
export ADMIN_NAME=Admin
export DATABASE_URL=sqlite:///$PWD/dev.db
export DATA_DIR=$PWD/devdata
export DEFAULT_LANGUAGE=en
# Optional, see README: SMTP_*, GSMSERVICE_*, FETCH_DENY_CIDRS
