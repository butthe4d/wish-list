#: wishlist/messages.py:11
msgid "You're invited to the wishlist"
msgstr "Zaproszenie do listy życzeń"

#: wishlist/messages.py:13
#, python-format
msgid ""
"Hi %(name)s,\n"
"\n"
"You have been invited to the household wishlist. Open this personal link "
"to sign in:\n"
"%(link)s\n"
"\n"
"Keep the link private: anyone who has it can act as you."
msgstr ""
"Cześć %(name)s,\n"
"\n"
"Zostałeś(-aś) zaproszony(-a) do domowej listy życzeń. Otwórz ten osobisty"
" link, aby się zalogować:\n"
"%(link)s\n"
"\n"
"Nie udostępniaj tego linku: każdy, kto go ma, może działać w Twoim "
"imieniu."

#: wishlist/messages.py:24
#, python-format
msgid "%(name)s shared a wishlist with you: %(list)s"
msgstr "%(name)s udostępnia Ci listę życzeń: %(list)s"

#: wishlist/messages.py:26
#, python-format
msgid ""
"Hi,\n"
"\n"
"%(name)s shared the wishlist \"%(list)s\" with you. Open it here to see "
"the items and reserve a gift:\n"
"%(link)s"
msgstr ""
"Cześć,\n"
"\n"
"%(name)s udostępnia Ci listę życzeń „%(list)s”. Otwórz ją tutaj, aby "
"zobaczyć pozycje i zarezerwować prezent:\n"
"%(link)s"

#: wishlist/messages.py:38
#, python-format
msgid "%(name)s shared the wishlist \"%(list)s\" with you: %(link)s"
msgstr "%(name)s udostępnia Ci listę życzeń „%(list)s”: %(link)s"

#: wishlist/messages.py:47
#, python-format
msgid "A reserved item was changed: %(item)s"
msgstr "Zarezerwowana pozycja została zmieniona: %(item)s"

#: wishlist/messages.py:49
#, python-format
msgid ""
"Hi %(admin)s,\n"
"\n"
"%(owner)s changed or removed \"%(item)s\", which %(reserver)s had "
"reserved via the list \"%(list)s\". You may want to let %(reserver)s "
"know."
msgstr ""
"Cześć %(admin)s,\n"
"\n"
"%(owner)s zmienia lub usuwa pozycję „%(item)s”, którą %(reserver)s "
"zarezerwował(a) przez listę „%(list)s”. Warto dać znać osobie "
"%(reserver)s."

#: wishlist/reservations.py:25
msgid "Please enter your name."
msgstr "Podaj swoje imię."

#: wishlist/sharing.py:42
msgid "Enter at least one email address."
msgstr "Podaj co najmniej jeden adres e-mail."

#: wishlist/sharing.py:44
#, python-format
msgid "Enter at most %(n)d email addresses."
msgstr "Podaj najwyżej %(n)d adresów e-mail."

#: wishlist/sharing.py:48
#, python-format
msgid "This is not a valid email address: %(address)s"
msgstr "To nie jest poprawny adres e-mail: %(address)s"

#: wishlist/sharing.py:57
msgid "Use international format, e.g. +48600100200."
msgstr "Użyj formatu międzynarodowego, np. +48600100200."

