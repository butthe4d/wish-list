#: wishlist/__init__.py:48
msgid "This page expired, please try again."
msgstr "Ta strona wygasła, spróbuj ponownie."

#: wishlist/catalog.py:33 wishlist/catalog.py:37
msgid "The link must start with http:// or https://."
msgstr "Link musi zaczynać się od http:// lub https://."

#: wishlist/catalog.py:43
msgid "The link is not a valid address."
msgstr "Link nie jest poprawnym adresem."

#: wishlist/catalog.py:45
msgid "The link is too long."
msgstr "Link jest zbyt długi."

#: wishlist/catalog.py:52 wishlist/catalog.py:140 wishlist/members.py:28
msgid "Name is required."
msgstr "Nazwa jest wymagana."

#: wishlist/catalog.py:54 wishlist/catalog.py:142 wishlist/reservations.py:33
msgid "Name is too long."
msgstr "Nazwa jest zbyt długa."

#: wishlist/catalog.py:57 wishlist/catalog.py:145
msgid "Description is too long."
msgstr "Opis jest zbyt długi."

#: wishlist/members.py:30
msgid "Name must be at most 100 characters."
msgstr "Nazwa może mieć najwyżej 100 znaków."

#: wishlist/members.py:32
msgid "Name must not contain control characters."
msgstr "Nazwa nie może zawierać znaków sterujących."

#: wishlist/members.py:35
msgid "Enter a valid email address."
msgstr "Podaj prawidłowy adres e-mail."

#: wishlist/members.py:37
msgid "Choose a supported language."
msgstr "Wybierz obsługiwany język."

#: wishlist/members.py:42 wishlist/members.py:51
msgid "A member with this email already exists."
msgstr "Członek z tym adresem e-mail już istnieje."

#: wishlist/members.py:72
msgid "There must be at least one admin."
msgstr "Musi pozostać co najmniej jeden administrator."

#: wishlist/members.py:80
msgid "You can't delete yourself."
msgstr "Nie możesz usunąć samego siebie."

#: wishlist/messages.py:17
msgid "You're invited to the wishlist"
msgstr "Zaproszenie do listy życzeń"

#: wishlist/messages.py:19
#, python-format
msgid ""
"Hi %(name)s,\n"
"\n"
"You have been invited to the household wishlist. Open this personal link "
"to sign in:\n"
"%(link)s\n"
"\n"
"Keep the link private: anyone who has it can act as you."
msgstr ""
"Cześć %(name)s,\n"
"\n"
"Zostałeś(-aś) zaproszony(-a) do domowej listy życzeń. Otwórz ten osobisty"
" link, aby się zalogować:\n"
"%(link)s\n"
"\n"
"Nie udostępniaj tego linku: każdy, kto go ma, może działać w Twoim "
"imieniu."

#: wishlist/messages.py:31
#, python-format
msgid "%(name)s shared a wishlist with you: %(list)s"
msgstr "%(name)s udostępnia Ci listę życzeń: %(list)s"

#: wishlist/messages.py:36
#, python-format
msgid ""
"Hi,\n"
"\n"
"%(name)s shared the wishlist \"%(list)s\" with you. Open it here to see "
"the items and reserve a gift:\n"
"%(link)s"
msgstr ""
"Cześć,\n"
"\n"
"%(name)s udostępnia Ci listę życzeń „%(list)s”. Otwórz ją tutaj, aby "
"zobaczyć pozycje i zarezerwować prezent:\n"
"%(link)s"

#: wishlist/messages.py:48
#, python-format
msgid "%(name)s shared the wishlist \"%(list)s\" with you: %(link)s"
msgstr "%(name)s udostępnia Ci listę życzeń „%(list)s”: %(link)s"

#: wishlist/messages.py:57
#, python-format
msgid "A reserved item was changed: %(item)s"
msgstr "Zarezerwowana pozycja została zmieniona: %(item)s"

#: wishlist/messages.py:59
#, python-format
msgid ""
"Hi %(admin)s,\n"
"\n"
"%(owner)s changed or removed \"%(item)s\", which %(reserver)s had "
"reserved via the list \"%(list)s\". You may want to let %(reserver)s "
"know."
msgstr ""
"Cześć %(admin)s,\n"
"\n"
"%(owner)s zmienia lub usuwa pozycję „%(item)s”, którą %(reserver)s "
"zarezerwował(a) przez listę „%(list)s”. Warto dać znać osobie "
"%(reserver)s."

#: wishlist/reservations.py:31
msgid "Please enter your name."
msgstr "Podaj swoje imię."

#: wishlist/sharing.py:45
msgid "Enter at least one email address."
msgstr "Podaj co najmniej jeden adres e-mail."

#: wishlist/sharing.py:47
#, python-format
